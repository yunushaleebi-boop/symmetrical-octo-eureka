---
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout title="Islamic Learning Portal">
  <main style="padding: 20px">
    <h1>Islamic Learning Portal</h1>
    <p>Lessons, Hajj guidance, and fiqh masā’il</p>

    <div class="grid" style="display: grid; gap: 12px; max-width: 320px; margin-top: 24px;">
      <a href="/blog" style="padding: 16px; border: 1px solid #ccc; border-radius: 8px; text-decoration: none; color: inherit;">Lessons</a>
      <a href="/courses/hajj" style="padding: 16px; border: 1px solid #ccc; border-radius: 8px; text-decoration: none; color: inherit;">Hajj Course</a>
      <a href="/masail" style="padding: 16px; border: 1px solid #ccc; border-radius: 8px; text-decoration: none; color: inherit;">Masā’il</a>
    </div>
  </main>
</BaseLayout>
